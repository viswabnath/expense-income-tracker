{
  "name": "expense-income-tracker",
  "version": "1.0.0",
  "main": "legacy/server.js",
  "scripts": {
    "start": "next start",
    "dev": "node scripts/dev.js",
    "setup-db": "node setup-db.js",
    "reset-test-db": "node reset-test-db.js",
    "reset-test-db-with-user": "node reset-test-db.js --with-user",
    "test": "jest --detectOpenHandles --forceExit",
    "test:clean": "npm run setup-test-db && npm run reset-test-db-with-user -- --yes && jest --detectOpenHandles --forceExit",
    "test:backend": "jest --selectProjects backend --detectOpenHandles --forceExit",
    "test:frontend": "jest --selectProjects frontend --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "setup-test-db": "DB_SCHEMA=balancetrack_test node setup-db.js",
    "test:e2e": "playwright test",
    "test:contract": "node scripts/run-contract-tests.js",
    "test:contract:stack": "node scripts/run-contract-tests.js --stack",
    "dev:legacy": "PORT=3001 nodemon legacy/server.js",
    "dev:web": "next dev",
    "build": "next build",
    "start:legacy": "node legacy/server.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --selectProjects unit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "path": "^0.12.7",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.1.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "coverageReporters": [
      "text",
      "html",
      "lcov"
    ],
    "coverageDirectory": "coverage",
    "detectOpenHandles": true,
    "forceExit": true,
    "projects": [
      {
        "displayName": "backend",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/integration.test.js",
          "<rootDir>/tests/api.test.js",
          "<rootDir>/tests/edge-cases.test.js",
          "<rootDir>/tests/setup-db.test.js",
          "<rootDir>/tests/setup-db-coverage.test.js",
          "<rootDir>/tests/activity-endpoint.test.js",
          "<rootDir>/tests/comprehensive-server-coverage.test.js",
          "<rootDir>/tests/server-edge-coverage.test.js",
          "<rootDir>/tests/server.test.js",
          "<rootDir>/tests/bank-deletion-fix.test.js",
          "<rootDir>/tests/cash-balance-activity.test.js",
          "<rootDir>/tests/security-middleware.test.js",
          "<rootDir>/tests/atomic-writes.test.js",
          "<rootDir>/tests/account-recovery.test.js",
          "<rootDir>/tests/entry-dates.test.js",
          "<rootDir>/tests/activity-api.test.js",
          "<rootDir>/tests/transaction-helper.test.js"
        ],
        "collectCoverageFrom": [
          "legacy/server.js",
          "setup-db.js",
          "legacy/lib/**/*.js"
        ],
        "setupFiles": [
          "<rootDir>/tests/env.js"
        ]
      },
      {
        "displayName": "frontend",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/tests/frontend-integration.test.js",
          "<rootDir>/tests/auth.test.js",
          "<rootDir>/tests/modular-architecture.test.js",
          "<rootDir>/tests/frontend-coverage.test.js",
          "<rootDir>/tests/activity-table-coverage.test.js",
          "<rootDir>/tests/smart-cash-button.test.js",
          "<rootDir>/tests/enhanced-summary-messages.test.js",
          "<rootDir>/tests/csp-compliance.test.js",
          "<rootDir>/tests/no-emoji.test.js"
        ],
        "collectCoverageFrom": [
          "legacy/public/js/**/*.js",
          "!legacy/public/js/lib/**"
        ],
        "setupFiles": [
          "<rootDir>/tests/env.js"
        ]
      },
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.(t|j)sx?$": [
            "@swc/jest",
            {
              "jsc": {
                "parser": {
                  "syntax": "typescript",
                  "tsx": true
                },
                "target": "es2022"
              },
              "module": {
                "type": "commonjs"
              }
            }
          ]
        },
        "collectCoverageFrom": [
          "lib/**/*.ts",
          "src/**/*.ts"
        ]
      }
    ],
    "testTimeout": 30000,
    "maxWorkers": 1
  }
}
