{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "syd1"
  ],
  "services": {
    "web": {
      "root": "./",
      "framework": "nextjs"
    },
    "legacy": {
      "root": "legacy/",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/_next/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(about|security|privacy|terms|next-health)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "legacy"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/((?!_next/|about$|security$|privacy$|terms$|next-health$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' https://unpkg.com;style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;font-src 'self' https://fonts.gstatic.com;img-src 'self' data:;connect-src 'self';upgrade-insecure-requests;default-src 'self';base-uri 'self';form-action 'self';frame-ancestors 'self';object-src 'none';script-src-attr 'none'"
        }
      ]
    }
  ]
}
